{
  "name": "dsh-computer-use-x11",
  "version": "0.1.0",
  "description": "Computer Use provider for Linux X11: windows, accessibility, screenshots and input through the shared cua tool",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "bin/x11-helper",
    "cordis.patch.yml",
    "docs",
    "icon.svg",
    "locale/*.json",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.2.2-rc.1",
      "node": ">=20.18"
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "computer-use",
    "x11",
    "linux",
    "at-spi",
    "xdotool"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/t3chj4ck/dsh-computer-use-x11.git"
  },
  "homepage": "https://github.com/t3chj4ck/dsh-computer-use-x11#readme",
  "author": "WU HAOJIE"
}
